<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH PortfolioDays AS (&#xa;    SELECT&#xa;        CAST(AsOfDate AS date) AS PositionDate,&#xa;        SUM(PnL) AS DailyPnL,&#xa;        CAST(SUM(PnL) / NULLIF(SUM(MarketValueBegin), 0) AS float) AS DailyRate&#xa;    FROM dbo.PositionDaily&#xa;    WHERE PortfolioId = 7&#xa;      AND AsOfDate &gt;= &apos;20230101&apos;&#xa;      AND AsOfDate &lt;  &apos;20240101&apos;&#xa;    GROUP BY CAST(AsOfDate AS date)&#xa;)&#xa;SELECT&#xa;    MONTH(PositionDate) AS MonthNumber,&#xa;    COUNT(*) AS TradingDays,&#xa;    SUM(DailyPnL) AS MonthlyPnL,&#xa;    CAST(100.0 * (EXP(SUM(LOG(1.0 + DailyRate))) - 1.0)&#xa;         AS decimal(12, 6)) AS MonthlyReturnPct&#xa;FROM PortfolioDays&#xa;GROUP BY MONTH(PositionDate)&#xa;ORDER BY MonthNumber" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x09008E2050C6B2D4FD3DFB9AF83F81E1214D0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.811639" StatementEstRows="12" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x5F4BAFA26AD44619" QueryPlanHash="0xBCE409D4E2FC8CA8" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1664" CachedPlanSize="56" CompileTime="2" CompileCPU="2" CompileMemory="632"><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="1664" RequiredMemory="1536" DesiredMemory="1664" RequestedMemory="1664" GrantWaitTime="0" MaxQueryMemory="2103928" GrantedMemory="1664" MaxUsedMemo